#!/sbin/openrc-run
# The PortaPixel device daemon. It serves the web UI and the API, and it
# supervises the player (plan section 8).

description="PortaPixel device daemon"
# The daemon starts the player itself, as the kiosk user:
#   mpv --idle=yes --vo=gpu --gpu-context=drm ...   (or --vo=drm)
# mpv runs directly on DRM/KMS. It needs no compositor, no seat daemon and no
# directory from this script: the daemon makes ${PP_RUN}/player for it.

# supervise-daemon restarts the daemon when it crashes (plan 3.3). The daemon
# then supervises the player. Nothing else supervises anything.
supervisor="supervise-daemon"
respawn_delay=5
# 0 = no limit. A signage box must always come back. supervise-daemon only
# counts crashes when respawn_period is set as well, so leaving the period out
# is what makes this unlimited. Do not add respawn_period.
respawn_max=0

# Defaults, so a missing or partly written /etc/conf.d/portapixeld cannot give
# the daemon an empty --media. Go's flag package would then read the next flag
# name as the value and the daemon would write to the wrong place.
: "${PP_MEDIA:=/media/ppmedia}"
: "${PP_STATE:=/var/lib/portapixel}"
: "${PP_RUN:=/run/portapixel}"
: "${PP_RELEASES:=/opt/portapixel}"
: "${PP_KIOSK_USER:=kiosk}"

command="${PP_RELEASES}/current/portapixeld"
# The quotes are inside the string on purpose: supervise-daemon puts this
# through eval, so a path with a space would become two arguments.
command_args="run --media \"${PP_MEDIA}\" --state \"${PP_STATE}\" --run \"${PP_RUN}\" --releases \"${PP_RELEASES}\" --kiosk-user \"${PP_KIOSK_USER}\""
pidfile="/run/portapixeld.pid"
output_log="/var/log/portapixeld.log"
error_log="/var/log/portapixeld.log"

# Stop schedule. Without "retry" supervise-daemon sends TERM, waits about five
# seconds, then sends KILL. The daemon needs longer. It gives the HTTP server a
# grace period, and only then tells the player to stop. A KILL at five seconds
# ends the daemon before it reaches the player. mpv then stays as an orphan and
# holds DRM master, and the next start finds no display. An update restarts the
# service, so the whole A/B flow depends on this line.
retry="TERM/25/KILL/5"

depend() {
	# The media partition holds the config and the playlists.
	need localmount
	after portapixel-firstboot portapixel-net
	# "use", never "need": the network must never stall playback (plan 3.3).
	# A box with no cable plays what it has.
	use net
}

gate_pidfile="/run/portapixel-health-gate.pid"

start_pre() {
	# 0755: the kiosk user must pass through this directory to reach
	# ${PP_RUN}/player, the socket of mpv, the transition script and the
	# fallback picture.
	checkpath -d -m 0755 "${PP_RUN}"

	# Start the update health gate FIRST, and before the binary check below.
	# It must run even when this start fails. A release whose binary cannot run
	# at all is the release that most needs a rollback. OpenRC does not run
	# start_post when the start fails.
	#
	# A normal boot pays NOTHING here: with no pending marker this block does not
	# run at all. The gate itself runs in the background, so it never holds up the
	# first picture.
	if [ -f "${PP_RELEASES}/.swap-pending" ]; then
		# The health marker of the daemon lives in tmpfs, under ${PP_RUN}/health,
		# and the daemon writes it there because this script gives it --run
		# ${PP_RUN}. A restart of the MACHINE empties tmpfs, so a marker of an
		# earlier boot cannot exist. A restart of the SERVICE alone does not, so
		# clear the directory here, before the daemon can write a marker.
		#
		# This is NOT "|| true". A marker that cannot be removed means the gate
		# cannot tell an old answer from a new one, and a gate that cannot be
		# trusted must not run at all: a passing gate keeps a release that never
		# proved itself.
		if ! rm -rf "${PP_RUN}/health"; then
			eerror "cannot clear ${PP_RUN}/health, so the update gate cannot be trusted"
			return 1
		fi
		checkpath -d -m 0755 "${PP_RUN}/health"
		start-stop-daemon --start --background \
			--make-pidfile --pidfile "$gate_pidfile" \
			--exec /usr/libexec/portapixel/health-gate.sh -- wait || true
	fi
	checkpath -d -m 0755 "${PP_RUN}/health"
	if [ ! -x "$command" ]; then
		eerror "no daemon binary at $command"
		eerror "this image was built with no --binary, or the current link is broken"
		return 1
	fi
	# On the flash: the .bad marker of a release that failed and the boot counter
	# of the gate. Both must survive a restart of the machine.
	checkpath -d -m 0755 "${PP_RELEASES}/health"
	checkpath -d -m 0755 "${PP_STATE}"

	# Clear tty1. The kernel shows tty1 each time mpv stops, for example at a
	# restart, until the next mpv takes the display. tty1 still holds the text of
	# the BIOS and of the boot loader: the kernel copies the VGA text screen into
	# tty1 when it takes the console. Measured in QEMU (SeaBIOS): that text was
	# on the screen for 1 s after each kill of mpv. ESC [3J also clears the
	# scrollback. The kernel command line hides the cursor. The -c test comes
	# first: a redirect to a missing device node makes a plain file in /dev.
	if [ -c /dev/tty1 ]; then
		printf '\033[H\033[2J\033[3J' >/dev/tty1 2>/dev/null || :
	fi
}

stop_pre() {
	# Stop the gate before the daemon goes down. The gate ends with
	# "rc-service portapixeld restart", so a gate left running would start again
	# a daemon that an operator stopped on purpose.
	if [ -f "$gate_pidfile" ]; then
		start-stop-daemon --stop --quiet --pidfile "$gate_pidfile" || true
		rm -f "$gate_pidfile"
	fi
}

stop_post() {
	# The daemon signals its own player. A daemon that was killed cannot do it.
	# mpv runs in a process group of its own, as the kiosk user. It would stay
	# as an orphan and hold DRM master. The next start would then find no
	# display.
	pkill -KILL -u "${PP_KIOSK_USER}" 2>/dev/null || true
	return 0
}
