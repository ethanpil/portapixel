#!/usr/bin/expect -f
# boot-smoke.exp -- drive the serial console of a PortaPixel image in QEMU.
# boot-smoke.sh calls this file. Do not run it by hand.
#
# Expect pitfall handled here: the guest terminal ECHOES every character we
# type, so a marker sent as part of a command matches its own echo before the
# command has even run. Markers are therefore SPLIT with quotes when sent
# (LOGIN"-OK") and matched UNSPLIT (LOGIN-OK). Only the OUTPUT of the command
# can make the unsplit string (mountnas technique).

set image  [lindex $argv 0]
set port   [lindex $argv 1]
set mem    [lindex $argv 2]
set scale  [lindex $argv 3]
set accel  [lindex $argv 4]
set bios   [lindex $argv 5]
set gpu    [lindex $argv 6]
# The version the caller expects from /etc/portapixel-release, or "" to read the
# value and only print it.
set want_version [lindex $argv 7]

# Strip terminal escape sequences from captured output. Bracketed paste toggles
# (\033[?2004h) land at the FRONT of the capture, so a plain trim does not
# remove them. Covers CSI, OSC and the two byte Fe escapes.
proc strip_ansi {s} {
	regsub -all {\x1b(?:\[[0-9;?]*[ -/]*[@-~]|\][^\x07]*\x07|[@-Z\\-_])} $s "" s
	return $s
}

proc die {msg} {
	send_user "\nFAIL: $msg\n"
	exit 1
}

# Per phase deadlines, scaled for TCG. Never one global timeout.
set t_boot  [expr {120 * $scale}]
set t_shell [expr {30 * $scale}]
set t_api   [expr {180 * $scale}]

# $gpu gives the guest a real DRM device, so mpv has a /dev/dri/card* to take.
# Without it there is no display at all and the player check fails for a reason
# that has nothing to do with the image. boot-smoke.sh picks the device.
set cmd "qemu-system-x86_64 $accel $bios -m $mem -nographic \
 $gpu \
 -drive file=$image,format=qcow2,if=virtio,discard=unmap,detect-zeroes=unmap \
 -netdev user,id=n0,hostfwd=tcp:127.0.0.1:$port-:80 \
 -device virtio-net-pci,netdev=n0"

send_user "==> $cmd\n"
eval spawn $cmd
set qemu_id $spawn_id

# ------------------------------------------------------------------ 1. the boot
set timeout $t_boot
expect {
	-re {login: *$}       { send_user "\n==> login prompt\n" }
	"Kernel panic"        { die "kernel panic" }
	"not a bootable disk" { die "the BIOS boot chain is broken: no syslinux VBR" }
	"Booting from Hard Disk" {
		# SeaBIOS says this and then hangs when the legacy bootable GPT
		# attribute or gptmbr.bin is missing. Keep waiting; the login prompt
		# below decides.
		exp_continue
	}
	timeout { die "no login prompt in ${t_boot}s" }
	eof     { die "QEMU stopped before the login prompt" }
}

# ----------------------------------------------------------------- 2. the login
set timeout $t_shell
send "root\r"
expect {
	-re {[Pp]assword: *$} { send "portapixel\r" }
	-re {~# *$}           { send_user "\n==> no password asked\n" }
	timeout               { die "no password prompt" }
}
# Unanchored on purpose. The prompt carries a trailing cursor position query
# escape ([6n), so a regex anchored with $ never matches.
expect {
	-re {[#$] } { }
	timeout     { die "no shell prompt after the login" }
}

send "echo LOGIN\"-OK\"\r"
expect {
	"LOGIN-OK" { send_user "\n==> shell works\n" }
	timeout    { die "the shell gave no output" }
}

# --------------------------------------------------- 3. the services and the log
send "rc-service portapixeld status; echo DSTAT\"=\"$?\r"
expect {
	-re {DSTAT=(\d+)} {
		set rc $expect_out(1,string)
		send_user "\n==> portapixeld status rc=$rc\n"
	}
	timeout { die "rc-service gave no answer" }
}

# Read the version back through a marker, not by printing the whole capture
# buffer: the buffer holds the echo of our own command as well, so it is not a
# clean value. "V""ER=" in the sent text echoes with the quotes in it and cannot
# match the bare VER= that the shell prints.
#
# FOUR rules, and each one cost a measurement.
#
# 1. The 80 column console. A typed line that is longer than the console leaves
#    the cursor in the middle of a line. The answer of the shell then starts
#    there and wraps INSIDE the value. So make the console wide first, and keep
#    the line that prints the value short.
# 2. The value needs an END mark. "(\S+)" matches as soon as the first character
#    of the value has arrived. Expect returned "0." for "0.0.1-ci1", and the
#    test read a version that the guest never said. Put the value between "<" and
#    ">" and match up to the ">": expect must then wait for the whole value.
#    The marks are "<" and ">" and not brackets, because a "[" inside a string in
#    double quotes is a command substitution to Tcl. The first attempt made expect
#    stop with: invalid command name ""$PORTAPIXEL_VERSION"".
# 3. The split-quote rule of the header applies to the marks as well. "V\"ER=<\""
#    echoes with the quote inside it, so the echo of our own command can never
#    make the string that the regular expression looks for.
# 4. Read the value and COMPARE it. The first version of this test printed the
#    value and checked nothing, so an image that named another version passed.
send "stty cols 200; . /etc/portapixel-release; echo ST\"TY-OK\"\r"
expect {
	"STTY-OK" { }
	timeout   { die "the shell did not read /etc/portapixel-release" }
}
send "echo V\"ER=<\"\$PORTAPIXEL_VERSION\">\"\r"
set got_version ""
expect {
	-re {VER=<([^>\r\n]*)>} {
		set got_version [strip_ansi $expect_out(1,string)]
		send_user "\n==> image version $got_version\n"
	}
	timeout { die "the shell printed no PORTAPIXEL_VERSION" }
}
if {$got_version eq ""} {
	die "/etc/portapixel-release gives an empty PORTAPIXEL_VERSION"
}
if {$want_version ne "" && $got_version ne $want_version} {
	die "the image says version \"$got_version\" and the caller expects \"$want_version\""
}

# ------------------------------------------------------------- 4. the HTTP check
# From the HOST, through the forwarded port. This is the check that matters: a
# browser on the LAN reaches the box the same way.
send_user "\n==> poll http://127.0.0.1:$port/api/status\n"
set deadline [expr {[clock seconds] + $t_api}]
set ok 0
set running 0
set item ""
set kind ""
while {[clock seconds] < $deadline} {
	if {[catch {exec curl -sS -m 5 "http://127.0.0.1:$port/api/status"} out] == 0} {
		if {[string match {*device_id*} $out] || [string match "*\{*" $out]} {
			if {$ok == 0} { send_user "==> /api/status answered: $out\n" }
			set ok 1
			# The player needs longer than the API. Keep polling until the
			# daemon says that mpv runs, because "the API answers" alone passed
			# on a device with a black screen.
			if {[string match {*"player_state":"running"*} $out]} {
				if {$running == 0} { send_user "==> player_state is running\n" }
				set running 1
			}
			# now_playing has an item only when mpv reported the start of a
			# file. A player process that shows nothing is a black screen with
			# a green status (plan section 17 item 4).
			if {[regexp {"now_playing":\{[^\}]*"item":"([^"]+)"[^\}]*"kind":"([a-z]+)"} $out -> got_item got_kind]} {
				if {$item eq ""} { send_user "==> now_playing: $got_kind $got_item\n" }
				set item $got_item
				set kind $got_kind
			}
			if {$running == 1 && $item ne ""} { break }
		}
	}
	after 3000
}
if {$ok == 1 && $running == 0} {
	send_user "\n==> the player never reached the running state:\n    $out\n"
}
if {$ok == 1 && $item eq ""} {
	send_user "\n==> now_playing never named an item:\n    $out\n"
}

# ----------------------------------------------------------- 5. the player check
# The daemon must have a DRM device and must have started mpv as the kiosk user
# (plan section 17 item 4, D43). Report the DRM device separately, so "QEMU gave
# us no graphics card" never reads as "the player crashed".
# ANY card, not card0. Under UEFI the firmware framebuffer driver takes card0 and
# virtio_gpu becomes card1, so a test for card0 alone reports "no display" on a
# machine that has one. The daemon must not assume card0 either.
send "ls /dev/dri 2>/dev/null | grep -q \"^card\" && echo DRI\"-YES\" || echo DRI\"-NO\"\r"
expect {
	"DRI-YES" { send_user "\n==> a DRM card is there\n" }
	"DRI-NO"  { send_user "\n==> NO DRM device: QEMU gave the guest no usable card\n" }
	timeout   { die "cannot look at /dev/dri" }
}
# The owner of the mpv process, between "<" and ">" (see the version rule
# above). An empty value means that no mpv runs.
set mpv_user ""
send "ps -o user,comm | awk '\$2 == \"mpv\" { u = \$1 } END { print \"MP\" \"V=<\" u \">\" }'\r"
expect {
	-re {MPV=<([^>\r\n]*)>} {
		set mpv_user [strip_ansi $expect_out(1,string)]
		send_user "\n==> mpv runs as \"$mpv_user\"\n"
	}
	timeout { die "ps gave no answer" }
}

# --------------------------------------------------------------- 6. shut it down
set spawn_id $qemu_id
set timeout $t_shell
send "poweroff\r"
expect {
	eof     { }
	timeout { }
}
catch {exec kill -TERM [exp_pid -i $qemu_id]}

if {$ok == 0} {
	die "/api/status did not answer in ${t_api}s on port $port"
}
if {$mpv_user eq ""} {
	die "the daemon did not start mpv. Read /run/portapixel/player.log and the
 ops log on the guest."
}
if {$mpv_user ne "kiosk"} {
	die "mpv runs as \"$mpv_user\" and it must run as kiosk (D43)"
}
if {$running == 0} {
	die "/api/status never reported player_state running.
 An mpv process alone is not a picture: it can wait for a display or stop
 again and again. Read the ops log and /run/portapixel/player.log on the guest."
}
if {$item eq ""} {
	die "/api/status named no now_playing item in ${t_api}s.
 mpv runs and reported no file, so the playlist did not load or no file
 opened. Read /run/portapixel/player.log on the guest."
}
send_user "\nPASS: the image boots, /api/status answers, mpv runs as kiosk and plays $kind $item\n"
exit 0
