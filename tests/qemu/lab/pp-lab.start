#!/bin/sh
# /etc/local.d/pp-lab.start -- bring the PortaPixel lab up again after a restart
# of the host. Enable it with: rc-update add local default
LAB=/root/ppwork/lab
exec >>"$LAB/local.d.log" 2>&1
date

. "$LAB/lab.env"

# The bridge. /etc/network/interfaces makes it at each boot, but Proxmox can
# write that file again, so this script makes the bridge when it is missing.
if ! ip link show "$BRIDGE" >/dev/null 2>&1; then
	echo "make $BRIDGE"
	ip link add name "$BRIDGE" type bridge
	ip link set "$BRIDGE" address "$HOST_MAC"
	ip link set "$BRIDGE" up
	ip addr flush dev eth0
	ip link set eth0 master "$BRIDGE"
	ip addr add "$HOST_ADDR" broadcast "$HOST_BCAST" dev "$BRIDGE"
	ip route add default via "$HOST_GW" dev "$BRIDGE" metric 202 2>/dev/null
fi

sh "$LAB/start-server.sh"
sh "$LAB/start-client.sh"
