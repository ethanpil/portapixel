# lab.env -- shared settings and helpers of the PortaPixel lab VMs.
# Every script of this directory reads this file. It is not a program.

LAB="${PP_LAB_DIR:-/root/ppwork/lab}"
BRIDGE="${PP_LAB_BRIDGE:-br0}"

# The LAN and the host. The bridge holds the address of the host, because eth0
# becomes a port of the bridge. Change these four values for another site.
HOST_ADDR=10.0.0.146/24
HOST_BCAST=10.0.0.255
HOST_GW=10.0.0.1
# The MAC of eth0. The bridge takes it, so the router gives the host the same
# address as before.
HOST_MAC=bc:24:11:1d:6c:8b
# The first three octets of the LAN, for the address search of vm_ip.
LAN_PREFIX=10.0.0

# pp-server: the fleet server on plain Alpine.
SRV_NAME=pp-server
SRV_TAP=tap-ppsrv
SRV_MAC=52:54:00:50:50:01
SRV_DIR="$LAB/server"
SRV_DISK="$SRV_DIR/server.qcow2"
SRV_MEM=1024
SRV_CPUS=1

# pp-client: a signage device from the real PortaPixel image.
CLI_NAME=pp-client
CLI_TAP=tap-ppcli
CLI_MAC=52:54:00:50:50:02
CLI_DIR="$LAB/client"
CLI_DISK="$CLI_DIR/client.qcow2"
CLI_MEM=2048
CLI_CPUS=2
# VNC on the loopback of the host only. A QEMU VNC password is weak, so the way
# in is an SSH tunnel:
#   ssh -L 5901:127.0.0.1:5901 root@<this host>
CLI_VNC=127.0.0.1:1

die() { printf '%s: %s\n' "${0##*/}" "$*" >&2; exit 1; }
say() { printf '==> %s\n' "$*"; }

# tap_up NAME makes the tap device and puts it in the bridge. QEMU runs with
# script=no, so the device must exist before QEMU opens it.
tap_up() {
	_t="$1"
	ip link show "$BRIDGE" >/dev/null 2>&1 ||
		die "no bridge $BRIDGE; the VMs have no way to the LAN"
	ip link show "$_t" >/dev/null 2>&1 || ip tuntap add dev "$_t" mode tap
	ip link set "$_t" master "$BRIDGE"
	ip link set "$_t" up
}

# mon SOCKET COMMAND sends one QEMU monitor command. socat closes the connection
# after 3 s of silence, because the monitor never says "done".
mon() {
	_s="$1"
	shift
	[ -S "$_s" ] || die "no monitor socket $_s; does the VM run?"
	printf '%s\n' "$*" | socat -T 3 - "UNIX-CONNECT:$_s" 2>/dev/null || true
}

# running PIDFILE says if the VM of that pidfile is alive.
running() {
	[ -f "$1" ] || return 1
	kill -0 "$(cat "$1")" 2>/dev/null
}

# serial_log SOCKET FILE writes the serial console into a file. One reader only.
serial_log() {
	setsid socat -u "UNIX-CONNECT:$1" "OPEN:$2,creat,append" >/dev/null 2>&1 &
}

# neigh_ip MAC reads the address of a MAC from the neighbour table. The MAC is
# field 3 of "ip neigh show dev DEV", because that form prints no "dev" column.
neigh_ip() {
	ip neigh show dev "$BRIDGE" 2>/dev/null |
		awk -v m="$1" '$3 == m { print $1; exit }'
}

# vm_ip MAC prints the LAN address of a MAC. It fills the neighbour table with a
# ping sweep first, because the container talks to nobody on the LAN by itself.
vm_ip() {
	_mac="$1"
	_ip="$(neigh_ip "$_mac")"
	if [ -z "$_ip" ]; then
		_i=1
		while [ "$_i" -lt 255 ]; do
			ping -c 1 -W 1 "$LAN_PREFIX.$_i" >/dev/null 2>&1 &
			_i=$((_i + 1))
		done
		wait
		sleep 1
		_ip="$(neigh_ip "$_mac")"
	fi
	printf '%s' "$_ip"
}
