# zero.env -- settings of pp-zero, the Raspberry Pi Zero 2 W proxy VM.
# The pp-zero scripts read it after lab.env. It changes nothing of pp-server or
# pp-client. It is not a program.
#
# pp-zero is an x86_64 KVM guest with virtio-gpu. It has the memory, the disk
# speed and about the CPU speed of a Zero 2 W. It has no VideoCore, no hardware
# decode and no ARM code, so it is a proxy and not a Pi.
ZERO_NAME=pp-zero
ZERO_TAP=tap-ppzero
ZERO_MAC=52:54:00:50:50:03
ZERO_DIR="$LAB/zero"
ZERO_BASE="$ZERO_DIR/base.qcow2"      # a qcow2 copy of an image; the VM never writes it
ZERO_DISK="$ZERO_DIR/zero.qcow2"      # an overlay of the base, 16 GB virtual, sparse
ZERO_MEM=512
ZERO_CPUS=4
# VNC on the loopback of the host only (TCP 5902). The way in is an SSH tunnel:
#   ssh -L 5902:127.0.0.1:5902 root@<this host>
ZERO_VNC=127.0.0.1:2
# microSD figures (an A1 class card): 40 MB/s read, 20 MB/s write, 1500 and
# 500 IOPS.
ZERO_BPS_RD=41943040
ZERO_BPS_WR=20971520
ZERO_IOPS_RD=1500
ZERO_IOPS_WR=500
# The CPU duty cycle of the whole QEMU process, in microseconds: it runs for
# ZERO_RUN_US, then dutythrottle stops it for ZERO_STOP_US.
ZERO_RUN_US=3000
ZERO_STOP_US=17000
# The duty cycle program. Build it one time with:
#   CGO_ENABLED=0 go build -o "$LAB/dutythrottle" ./tests/qemu/lab/dutythrottle
ZERO_THROTTLE="$LAB/dutythrottle"
