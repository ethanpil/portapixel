# systemd unit of the PortaPixel fleet server.
#
# Install it:
#   install -m 755 portapixel-server /usr/local/bin/
#   install -m 644 portapixel-server.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now portapixel-server
#
# The first start prints the admin password. Read it:
#   journalctl -u portapixel-server | grep -A4 "first run"

[Unit]
Description=PortaPixel fleet server
Documentation=https://github.com/ethanpil/portapixel
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/portapixel-server run --data /var/lib/portapixel-server --listen :8080
Restart=on-failure
RestartSec=5
# The server stops gracefully in 8 s: a download of a large video gets that time.
# systemd must give it more than that, or it kills the process in the middle of the
# work that the grace period protects.
TimeoutStopSec=15

# DynamicUser makes the account and gives it the state directory. There is no
# user to add and no directory to chown, and the account cannot be logged in to.
DynamicUser=yes
StateDirectory=portapixel-server
StateDirectoryMode=0750

# The server writes its data directory and nothing else. It needs no privilege.
# The port is above 1024. The media, the database and the mirror are all in the
# state directory.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# AF_INET and AF_INET6 for HTTP, AF_UNIX for the resolver.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=

# A port below 1024 needs one capability. Uncomment both lines, and only then.
# AmbientCapabilities=CAP_NET_BIND_SERVICE
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
