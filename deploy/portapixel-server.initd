#!/sbin/openrc-run
# OpenRC service of the PortaPixel fleet server.
#
# Install it on Alpine:
#   install -m 755 portapixel-server.initd /etc/init.d/portapixel-server
#   install -m 644 portapixel-server.confd /etc/conf.d/portapixel-server
#   install -m 755 portapixel-server /usr/local/bin/
#   addgroup -S portapixel && adduser -S -D -H -G portapixel portapixel
#   install -d -o portapixel -g portapixel -m 750 /var/lib/portapixel-server
#   rc-update add portapixel-server default && rc-service portapixel-server start
#
# The first start prints the admin password. Read it:
#   grep first /var/log/portapixel-server.log

name="portapixel-server"
description="PortaPixel fleet server"

: "${data_dir:=/var/lib/portapixel-server}"
: "${listen:=:8080}"
: "${server_user:=portapixel}"
: "${server_group:=portapixel}"

command="/usr/local/bin/portapixel-server"
# The quotes are inside the string on purpose: supervise-daemon puts this through
# eval, so a data directory with a space in it would become two arguments. The
# server would then make a second, empty database and print a new admin password
# while the real data stayed where it was.
command_args="run --data \"${data_dir}\" --listen \"${listen}\""
command_user="${server_user}:${server_group}"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/${RC_SVCNAME}.log"
error_log="/var/log/${RC_SVCNAME}.log"

# supervise-daemon starts the server again when it stops. The server holds no
# state in memory that a restart loses: the sessions go, and one admin logs in
# again.
supervisor="supervise-daemon"
respawn_delay=5
respawn_max=0
# The server stops gracefully in 8 s: a download of a large video gets that time.
# supervise-daemon waits about 5 s by default, so it would kill the process in the
# middle of the work that the grace period protects.
retry="TERM/15/KILL/5"

depend() {
	# "use", not "need". The server listens on a port, which needs no interface
	# to be up. ifupdown-ng exits non-zero when ANY configured interface fails, so
	# one unplugged second card, or a DHCP server that is slow, makes "net" fail.
	# With "need" OpenRC would then leave the fleet server stopped, and it does
	# not start it again when the link comes back. "use" keeps the ordering and
	# drops the condition.
	use net
	need localmount
	after firewall
}

start_pre() {
	checkpath --directory --owner "${server_user}:${server_group}" --mode 0750 "${data_dir}"
	checkpath --file --owner "${server_user}:${server_group}" --mode 0640 "${output_log}"
}
